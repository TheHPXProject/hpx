pipeline {
    agent any
    options {
        buildDiscarder(
            logRotator(
                daysToKeepStr: "14",
                numToKeepStr: "50",
                artifactDaysToKeepStr: "14",
                artifactNumToKeepStr: "50"
            )
        )
    }

    stages {
        stage('test-coverage') {
            // A coverage run needs a full Debug build plus the entire test suite,
            // which does not fit into a pull request turnaround. Restrict it to
            // branch builds, which is what this Jenkins job indexes anyway.
            when { not { changeRequest() } }

            environment{
                CODACY_TOKEN = credentials('CODACY_TOKEN_HPX')
                configuration_name = "test-coverage"
            }
            steps {
                echo "Running ${env.BUILD_ID} on ${env.JENKINS_URL}"
                sh '''
                #!/bin/bash -l
                .jenkins/lsu-test-coverage/entry.sh
                '''
            }
        }
    }

    post {
        always {
            // Only a skipped pull request run has nothing to archive. A branch
            // build that produced no coverage log must still fail.
            script {
                def skipped = env.CHANGE_ID != null
                archiveArtifacts artifacts: 'jenkins-hpx-*', fingerprint: true,
                    allowEmptyArchive: skipped
                archiveArtifacts artifacts: 'grcov-log.txt', fingerprint: true,
                    allowEmptyArchive: skipped
            }
        }
    }
}
