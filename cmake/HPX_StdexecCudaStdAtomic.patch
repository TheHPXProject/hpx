--- a/include/stdexec/__detail/__atomic.hpp
+++ b/include/stdexec/__detail/__atomic.hpp
@@ -28,5 +28,5 @@
 #  if !STDEXEC_USE_MODULES()
-#    if __has_include(<cuda/std/atomic>)
+#    if !defined(STDEXEC_NO_CUDA_STD_ATOMIC) && __has_include(<cuda/std/atomic>)
 #      include <cuda/std/atomic>
 #      define STDEXEC_HAS_CUDA_STD_ATOMIC() 1
 #    else
