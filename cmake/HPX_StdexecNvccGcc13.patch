diff --git a/include/stdexec/__detail/__config.hpp b/include/stdexec/__detail/__config.hpp
index e7b22ab..a33b500 100644
--- a/include/stdexec/__detail/__config.hpp
+++ b/include/stdexec/__detail/__config.hpp
@@ -609,7 +609,7 @@ namespace STDEXEC
 #  define STDEXEC_IMMOVABLE(_XP) _XP(_XP&&) = delete
 #endif

-#if STDEXEC_GCC()
+#if STDEXEC_GCC() || (STDEXEC_NVCC() && defined(__GNUC__) && !defined(__clang__))
 // BUG (gcc#98995): copy elision fails when initializing a [[no_unique_address]]
 // field from a function returning an object of class type by value. See:
 // https://gcc.gnu.org/bugzilla/show_bug.cgi?id=98995
diff --git a/include/stdexec/__detail/__meta.hpp b/include/stdexec/__detail/__meta.hpp
index 3275412..6ca26c5 100644
--- a/include/stdexec/__detail/__meta.hpp
+++ b/include/stdexec/__detail/__meta.hpp
@@ -60,6 +60,9 @@ namespace STDEXEC
 #  if STDEXEC_GCC() && STDEXEC_GCC_VERSION < 1300
   template <auto _Value>
   using __mtypeof = std::remove_const_t<decltype(_Value)>;
+#  elif STDEXEC_NVCC()
+  template <auto _Value>
+  using __mtypeof = std::remove_cvref_t<decltype(_Value)>;
 #  else
   template <auto _Value>
   using __mtypeof = decltype(_Value);
diff --git a/include/stdexec/__detail/__receivers.hpp b/include/stdexec/__detail/__receivers.hpp
index 2cc3197..37de040 100644
--- a/include/stdexec/__detail/__receivers.hpp
+++ b/include/stdexec/__detail/__receivers.hpp
@@ -423,13 +423,23 @@ namespace STDEXEC
     {
       if constexpr (__std::same_as<void, __invoke_result_t<_Fun, _As...>>)
       {
+#  if STDEXEC_NVCC()
+        decltype(__invoke){}(static_cast<_Fun &&>(__fun), static_cast<_As &&>(__as)...);
+        STDEXEC::set_value_t{}(static_cast<_Receiver &&>(__rcvr));
+#  else
         __invoke(static_cast<_Fun &&>(__fun), static_cast<_As &&>(__as)...);
         STDEXEC::set_value(static_cast<_Receiver &&>(__rcvr));
+#  endif
       }
       else
       {
+#  if STDEXEC_NVCC()
+        STDEXEC::set_value_t{}(static_cast<_Receiver &&>(__rcvr),
+                           decltype(__invoke){}(static_cast<_Fun &&>(__fun), static_cast<_As &&>(__as)...));
+#  else
         STDEXEC::set_value(static_cast<_Receiver &&>(__rcvr),
                            __invoke(static_cast<_Fun &&>(__fun), static_cast<_As &&>(__as)...));
+#  endif
       }
     }
     STDEXEC_CATCH_ALL
