diff --git a/include/stdexec/__detail/__basic_sender.hpp b/include/stdexec/__detail/__basic_sender.hpp
index 0a8137d..f40d587 100644
--- a/include/stdexec/__detail/__basic_sender.hpp
+++ b/include/stdexec/__detail/__basic_sender.hpp
@@ -125,7 +125,11 @@ namespace STDEXEC
           -> __tuple<connect_result_t<_Child, __rcvr<_Tag, _State, _Idx>>...>
       {
         return __tuple{
+#  if STDEXEC_NVCC()
+          STDEXEC::connect_t{}(static_cast<_Child&&>(__child), __rcvr<_Tag, _State, _Idx>{__state})...};
