diff --git a/include/exec/async_scope.hpp b/include/exec/async_scope.hpp
--- a/include/exec/async_scope.hpp
+++ b/include/exec/async_scope.hpp
@@ -819,11 +819,20 @@ namespace experimental::execution
                                                             static_cast<_Constrained&&>(__c)};
       }
 
+#if STDEXEC_NVCC()
+      template <class _Just = just_t>
+      [[nodiscard]]
+      constexpr auto on_empty() const
+      {
+        return when_empty(_Just{}());
+      }
+#else
       [[nodiscard]]
       constexpr auto on_empty() const
       {
         return when_empty(just());
       }
+#endif
 
       template <sender _Constrained>
       [[nodiscard]]
