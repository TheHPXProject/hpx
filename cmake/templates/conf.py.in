# Fix Sphinx/Breathe duplicate declaration warnings caused by repeated
# C++ namespace rendering. Apply a filter to suppress only namespace
# types (hpx, ranges, experimental) emitted as cpp:type duplicates.
# This prevents false-positive 'Duplicate C++ declaration' warnings
# while preserving all real API duplication checks.
class _BreatheNamespaceDuplicateFilter(py_logging.Filter):
    namespace_type_declarations = {
        "hpx",
        "ranges",
        "experimental",
    }

    def filter(self, record):
        message = record.getMessage()
        prefix = "Declaration is '.. cpp:type:: "
        if not message.startswith("Duplicate C++ declaration"):
            return True
        if prefix not in message:
            return True

        declaration = message.split(prefix, 1)[1].split("'.", 1)[0]
        return declaration not in self.namespace_type_declarations


def setup(app):
    py_logging.getLogger('sphinx.sphinx.domains.cpp').addFilter(
        _BreatheNamespaceDuplicateFilter())


