def sanitize_page_name(title):
    return re.sub(r'[^A-Za-z0-9_]+', '_', title).strip('_')


def populate_symbol_anchors(module, out_root):
    """First pass over `module`'s headers: populate all_symbol_anchors for
    every \\page-tagged symbol without writing any files. This must run
    for every module before generate_module_api_refs() writes any page
    bodies, since a page's "See also" cross-reference (via
    overload_counterparts) may point at a symbol whose anchor is only
    known once its (possibly later-processed) module/header has been
    scanned."""
    assert module in breathe_projects_source.keys()
    module_sources = breathe_projects_source[module]
    if len(module_sources[1]) == 0:
        return
    header_names = set()
    symbol_page_names = set()
    for source in module_sources[1]:
        header = source[len('include/'):]
        header_splitted = re.split('[/ .]', header)
        header_name = header_splitted[-2]
        if header_name in header_names:
            header_name = '{0}_{1}'.format(header_splitted[-3], header_name)
        header_names.add(header_name)
        page_groups, _, _ = header_info.get(header, ([["None"]], "None", {}))
        if page_groups == [["None"]]:
            continue
        for group in page_groups:
            for title in group:
                if title == "None":
                    continue
                symbol_page_name = header_name + '_' + sanitize_page_name(title)
                if symbol_page_name in symbol_page_names:
                    prefix = (header_splitted[-3]
                        if len(header_splitted) >= 3 else module)
                    symbol_page_name = '{0}_{1}'.format(
                        prefix, symbol_page_name)
                symbol_page_names.add(symbol_page_name)
                all_symbol_anchors[title] = 'modules_{0}_api'.format(symbol_page_name)


def generate_module_api_refs(module, out_root):
    """Generate full_api.rst and per-header/per-symbol API pages for a
    single module. `out_root` is the doc-tree-relative path under which
    the module's own `api/` directory lives, e.g. 'libs/full/supervision'
    or 'components/supervision_dispatch'. Returns the toctree entry line
    for full_api.rst, or '' if the module had no scanned sources."""
    assert module in breathe_projects_source.keys()
    module_sources = breathe_projects_source[module]
    if len(module_sources[1]) == 0:
        return ''

    basedir = os.path.abspath('.') + '/' + out_root + '/api'
    if not os.path.exists(basedir):
        os.makedirs(basedir)
    module_api_ref = open(basedir + '/full_api.rst', 'w')
    module_api_ref.write(api_ref_header.format(module, '-' * len(module)))

    header_refs = ''
    header_names = set()       # uniquifies whole-file pages (headers w/o \page)
    symbol_page_names = set()  # uniquifies per-symbol pages (headers w/ \page)
    for source in module_sources[1]:
        header = source[len('include/'):]
        header_splitted = re.split('[/ .]', header)

        header_name = header_splitted[-2]
        if header_name in header_names:
            header_name = '{0}_{1}'.format(header_splitted[-3], header_name)
        header_names.add(header_name)

        page_groups, include_header, kind_map = header_info.get(
            header, ([["None"]], "None", {}))
        if include_header == "None":
            include_header = header

        if page_groups == [["None"]]:
            header_ref = open(basedir + '/' + header_name + '.rst', 'w')
            header_ref.write(api_header_file.format(header, module, header,
                find_link_hpx_header(include_header), '-' * len(header)))
            header_ref.close()
            header_refs += '   /' + out_root + '/api/' + header_name + '.rst\n'
            continue

        title_to_pagename = {}
        for group in page_groups:
            for title in group:
                if title == "None":
                    continue
                symbol_page_name = header_name + '_' + sanitize_page_name(title)
                if symbol_page_name in symbol_page_names:
                    prefix = (header_splitted[-3]
                        if len(header_splitted) >= 3 else module)
                    symbol_page_name = '{0}_{1}'.format(
                        prefix, symbol_page_name)
                symbol_page_names.add(symbol_page_name)
                title_to_pagename[title] = symbol_page_name
                all_symbol_anchors[title] = 'modules_{0}_api'.format(symbol_page_name)

        for group in page_groups:
            for page_title in group:
                if page_title == "None":
                    continue
                symbol_page_name = title_to_pagename[page_title]
                siblings = [t for t in group if t != page_title]
                see_also = ""
                if siblings:
                    see_also = "\nSee also:\n\n" + "\n".join(
                        '   - :ref:`{0} <modules_{1}_api>`'.format(
                            sib, title_to_pagename[sib])
                        for sib in siblings) + "\n"

                counterpart_title = overload_counterparts.get(page_title)
                if counterpart_title:
                    hpx_role = _DOXYGEN_DIRECTIVE_TO_HPX_ROLE.get(
                        detect_symbol_kind(counterpart_title), 'func')
                    see_also += "\n.. seealso::\n   :hpx:{0}:`{1}`\n".format(
                        hpx_role, counterpart_title)

                symbol_ref = open(basedir + '/' + symbol_page_name + '.rst', 'w')
                kind = kind_map.get(page_title, 'doxygenfunction')

                symbol_target = page_symbol_targets.get(page_title, page_title)
                if kind == 'doxygenfunction':
                    overload_sigs = find_overloads(symbol_target)
                else:
                    overload_sigs = []

                if not overload_sigs:
                    directive_block = '.. {0}:: {1}\n   :project: hpx'.format(kind, symbol_target)
                else:
                    directive_block = '\n'.join(
                        '.. {0}:: {1}{2}\n   :project: hpx'.format(kind, symbol_target, sig)
                        for sig in overload_sigs)

                symbol_ref.write(api_symbol_file.format(
                    symbol_page_name, page_title,
                    find_link_hpx_header(include_header),
                    '-' * len(page_title), see_also, directive_block))

                symbol_ref.close()
                header_refs += ('   /' + out_root +
                    '/api/' + symbol_page_name + '.rst\n')

    module_api_ref.write(api_file)
    module_api_ref.write(header_refs)
    module_api_ref.close()
    return '   /' + out_root + '/api/full_api.rst\n'


# Pass 1: populate all_symbol_anchors (and, via get_info_from_file()
# above, overload_counterparts) across *all* modules before writing any
# page bodies, since module processing order is not guaranteed to match
# the order in which "See also" counterparts need to be resolved.
for lib in hpx_libs.keys():
    for module in sorted(hpx_libs[lib]):
        populate_symbol_anchors(module, 'libs/' + lib + '/' + module)

for module in sorted(hpx_components):
    populate_symbol_anchors(module, 'components/' + module)

# Pass 2: emit the actual page bodies, now that all_symbol_anchors and
# overload_counterparts are fully known.
for lib in hpx_libs.keys():
    for module in sorted(hpx_libs[lib]):
        api_refs += generate_module_api_refs(module, 'libs/' + lib + '/' + module)

for module in sorted(hpx_components):
    api_refs += generate_module_api_refs(module, 'components/' + module)


# write found symbols to 'symbol_anchors.json' for the :hpx:<kind>:
# sphinx roles to pick up (see: extensions/sphinx-hpx.py)
json_path = os.path.join(os.path.abspath('.'), 'api/symbol_anchors.json')
with open(json_path, 'w') as json_file:
    json.dump(all_symbol_anchors, json_file, indent=2, sort_keys=True)


api_rst = open(os.path.abspath('.') + '/api/full_api.rst', 'w')
for line in open(hpx_source_dir + '/docs/sphinx/api/full_api.rst').readlines():
    api_rst.write(line.format(api_refs))
api_rst.close()

