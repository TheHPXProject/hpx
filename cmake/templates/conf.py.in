# Symmetric mapping between a page's title (the key used in
# all_symbol_anchors) and its "distributed"/"core" counterpart's title,
# for pages that were split into distinct Doxygen page IDs to avoid
# "multiple use of page label" warnings while still wanting a "See also"
# cross-reference between the two pages, e.g.
# "hpx::async" <-> "hpx::async (distributed)".
overload_counterparts = {}

_doxygen_xml_dir = os.path.abspath(breathe_projects['hpx'])
_function_signatures_by_qualname = None
_symbol_kinds_by_qualname = None

# Maps a Doxygen compounddef/memberdef "kind" attribute to the Breathe
# directive used to document it.
_DOXYGEN_KIND_TO_DIRECTIVE = {
    'class': 'doxygenclass',
    'struct': 'doxygenstruct',
    'union': 'doxygenclass',
    'variable': 'doxygenvariable',
    'enum': 'doxygenenum',
    'typedef': 'doxygentypedef',
    'function': 'doxygenfunction',
    'concept': 'doxygenconcept',
}

# Maps a Breathe directive (as returned by detect_symbol_kind() below) to
# the matching disambiguation-aware ":hpx:<kind>:" role registered by
# extensions/sphinx-hpx.py, used to emit kind-aware counterpart "See also"
# cross-references (see populate see_also below).
_DOXYGEN_DIRECTIVE_TO_HPX_ROLE = {
    'doxygenclass': 'class',
    'doxygenstruct': 'struct',
    'doxygenvariable': 'member',
    'doxygenenum': 'enum',
    'doxygentypedef': 'type',
    'doxygenfunction': 'func',
    'doxygenconcept': 'concept',
    'doxygenvariable': 'variable',
}

def _load_doxygen_function_signatures():
    """Lazily parse the already-generated Doxygen XML once, building a map
    from fully-qualified function name -> list of real Doxygen
    <argsstring> signatures (one entry per overload)."""
    global _function_signatures_by_qualname
    if _function_signatures_by_qualname is not None:
        return _function_signatures_by_qualname

    signatures = {}
    for xml_path in glob.glob(os.path.join(_doxygen_xml_dir, '*.xml')):
        if os.path.basename(xml_path) in ('index.xml', 'Doxyfile.xml'):
            continue
        try:
            tree = ET.parse(xml_path)
        except ET.ParseError:
            continue

        # Walk compounddef -> compoundname so every memberdef inside it is
        # keyed consistently, instead of relying on each memberdef's own
        # (unreliably-populated) <qualifiedname>
        for compounddef in tree.getroot().iter('compounddef'):
            compoundname_el = compounddef.find('compoundname')
            compoundname = (compoundname_el.text.strip()
                if compoundname_el is not None and compoundname_el.text else '')

            for memberdef in compounddef.iter('memberdef'):
                if memberdef.get('kind') != 'function':
                    continue

                name_el = memberdef.find('name')
                if name_el is None or not name_el.text:
                    continue
                name = name_el.text.strip()

                qualname = f'{compoundname}::{name}' if compoundname else name

                argsstring_el = memberdef.find('argsstring')
                argsstring = (argsstring_el.text.strip()
                    if argsstring_el is not None and argsstring_el.text else '')

                signatures.setdefault(qualname, []).append(argsstring)

    _function_signatures_by_qualname = signatures
    return signatures


def _load_doxygen_symbol_kinds():
    """Lazily parse the already-generated Doxygen XML once, building a map
    from fully-qualified symbol name (as it appears in the XML) -> Breathe
    directive name ("doxygenclass", "doxygenstruct", "doxygenvariable",
    ...), mirroring the compounddef/memberdef walk already done by
    _load_doxygen_function_signatures()."""
    global _symbol_kinds_by_qualname
    if _symbol_kinds_by_qualname is not None:
        return _symbol_kinds_by_qualname
    kinds = {}
    for xml_path in glob.glob(os.path.join(_doxygen_xml_dir, '*.xml')):
        if os.path.basename(xml_path) in ('index.xml', 'Doxyfile.xml'):
            continue
        try:
            tree = ET.parse(xml_path)
        except ET.ParseError:
            continue
        for compounddef in tree.getroot().iter('compounddef'):
            compoundname_el = compounddef.find('compoundname')
            compoundname = (compoundname_el.text.strip()
                if compoundname_el is not None and compoundname_el.text else '')
            # Classes/structs/unions are themselves compounds - record the
            # compound's own fully-qualified name.
            compound_directive = _DOXYGEN_KIND_TO_DIRECTIVE.get(
                compounddef.get('kind'))
            if compound_directive and compoundname:
                kinds[compoundname] = compound_directive
            # Variables, enums, typedefs and functions are members of a
            # namespace/class compound - qualify them with the enclosing
            # compound's name, exactly like the overload-disambiguation map
            # above, so e.g. `hpx::adjacent_find` (a variable in namespace
            # `hpx`) never collides with an unrelated `detail::adjacent_find`
            # struct that merely shares the unqualified name.
            for memberdef in compounddef.iter('memberdef'):
                name_el = memberdef.find('name')
                if name_el is None or not name_el.text:
                    continue
                name = name_el.text.strip()
                qualname = f'{compoundname}::{name}' if compoundname else name
                member_directive = _DOXYGEN_KIND_TO_DIRECTIVE.get(
                    memberdef.get('kind'))
                if member_directive:
                    kinds[qualname] = member_directive
    _symbol_kinds_by_qualname = kinds
    return kinds


_doc_logger = py_logging.getLogger('hpx.sphinx.doxygen_overloads')

def find_overloads(qualified_name):
    """Return the real Doxygen <argsstring> signatures needed to
    disambiguate `.. doxygenfunction::` for every overload of
    `qualified_name`.

    - [] if there are 0 or 1 matching entries: caller emits a single bare,
      unsuffixed directive (unambiguous).
    - list of signatures if there are multiple overloads: caller emits one
      directive per signature.
    """
    signatures = _load_doxygen_function_signatures()
    matches = signatures.get(qualified_name)

    if matches is None:
        # Key entirely absent from the map - distinct from "legitimately
        # has exactly one overload". Likely a naming/parsing mismatch or
        # incomplete Doxygen XML, worth surfacing in the build log.
        _doc_logger.warning(
            "doxygenfunction target '%s' not found in Doxygen XML "
            "signature map (%d qualified names loaded from %s); "
            "emitting an unsuffixed directive that may fail to resolve "
            "or resolve ambiguously at Sphinx build time.",
            qualified_name, len(signatures), _doxygen_xml_dir)
        return []

    return matches if len(matches) > 1 else []


def detect_symbol_kind(title):
    """Look up the Breathe directive for a \\page-tagged symbol title from
    the already-generated Doxygen XML, keyed by the exact fully-qualified
    name (e.g. `hpx::adjacent_find`). Unlike scanning the raw header text,
    this can't be fooled by an unrelated same-named symbol declared in a
    different (e.g. detail) namespace."""
    if not title:
        return "doxygenfunction"

    kinds = _load_doxygen_symbol_kinds()
    kind = kinds.get(title)
    if kind is None:
        _doc_logger.warning(
            "symbol '%s' not found in Doxygen XML kind map (%d qualified "
            "names loaded from %s); falling back to doxygenfunction, which "
            "may fail to resolve.",
            title, len(kinds), _doxygen_xml_dir)
        return "doxygenfunction"
    return kind


def get_info_from_file(source):
    page_groups = []
    header = "None"
    kind_map = {}
    if os.path.exists(source):
        with open(source, 'r') as file:
            content = file.read()
        for line in content.splitlines():
            if "/// \\page" in line:
                page_value = line.split("/// \\page", 1)[-1].strip()
                if ',' in page_value:
                    group = [t.strip() for t in page_value.split(',') if t.strip()]
                else:
                    # Either a plain "\page <qualified-name>" tag, or a
                    # two-token "\page <unique-page-id> <title>" tag used
                    # to give a page a Doxygen-unique ID while keeping a
                    # descriptive title (e.g. "hpx::async (distributed)").
                    # <title> (kept verbatim) is what all other
                    # bookkeeping below (anchors, kind lookups,
                    # doxygenfunction targets) keys off of, exactly as if
                    # the single-token form had been used.
                    page_id, _, remainder = page_value.partition(' ')
                    remainder = remainder.strip()
                    title = remainder if remainder else page_id
                    if remainder:
                        leading_token = title.split()[0]
                        page_symbol_targets[title] = leading_token
                        overload_counterparts[title] = leading_token
                        overload_counterparts[leading_token] = title
                    group = [title]
                if group:
                    page_groups.append(group)
            elif "/// \\headerfile" in line:
                header = line.split("/// \\headerfile", 1)[-1].strip()

        # Merge every \page tag in this header into one group so all its
        # symbols become mutual "See also" siblings, regardless of which
        # \page line introduced them. De-duplicate titles that appear in
        # more than one tag, preserving first-seen order.
        merged_group = []
        for group in page_groups:
            for title in group:
                if title not in merged_group:
                    merged_group.append(title)
        page_groups = [merged_group] if merged_group else [["None"]]
        for title in merged_group:
            kind_map[title] = detect_symbol_kind(
                page_symbol_targets.get(title, title))

    if not page_groups:
        page_groups = [["None"]]
    return page_groups, header, kind_map


