--- a/include/stdexec/__detail/__structured_binding_size.hpp
+++ b/include/stdexec/__detail/__structured_binding_size.hpp
@@ -48,7 +48,7 @@ namespace STDEXEC
   template <class _Ty>
   inline constexpr int __structured_binding_size_v = -1;
 
-#  if STDEXEC_HAS_BUILTIN(__builtin_structured_binding_size)
+#  if STDEXEC_HAS_BUILTIN(__builtin_structured_binding_size) && !defined(__NVCC__)
