diff --git a/include/stdexec/__detail/__inline_scheduler.hpp b/include/stdexec/__detail/__inline_scheduler.hpp
--- a/include/stdexec/__detail/__inline_scheduler.hpp
+++ b/include/stdexec/__detail/__inline_scheduler.hpp
@@ -93,7 +93,11 @@ namespace STDEXEC
     constexpr auto operator==(inline_scheduler const &) const noexcept -> bool = default;
   };
 
+#if STDEXEC_NVCC()
+  static_assert(__completes_inline<set_value_t, __inline_attrs>);
+#else
   static_assert(__completes_inline<set_value_t, env_of_t<schedule_result_t<inline_scheduler>>>);
+#endif
 }  // namespace STDEXEC
 
 #  include "__epilogue.hpp"
